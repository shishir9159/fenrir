*
!*/
!.gitignore
!README.md
!myths.md
!*.zig
!build.zig.zon

# Shader sources, and the SPIR-V committed so a checkout builds with no
# compiler (`zig build -Dshaders=spirv`, regenerated by `zig build spirv`).
!src/gleipnir/shader/*.glsl
!src/gleipnir/shader/*.vert
!src/gleipnir/shader/*.frag
!src/gleipnir/shader/slang/*.slang
!src/gleipnir/shader/spirv/*.spv

# Build output. Listed after the rules above because `!*.zig` would otherwise
# pull in the options file Zig generates in the cache.
.zig-cache/
zig-out/
zig-pkg/
!src/tyr/backend/*.h
